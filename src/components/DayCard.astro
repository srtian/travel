---
import { render } from 'astro:content';
const { entry, index } = Astro.props;
const day = entry.data;
const { Content, headings } = await render(entry);
const sections = headings.filter(heading => heading.depth === 2);
---
<article class="day-card panel" id={`day-${index + 1}`}>
  <header class="day-header">
    <div class="day-number"><span>DAY {String(index + 1).padStart(2, '0')}</span><strong>{day.date?.slice(5).replace('-', '/')}</strong><small>{day.weekday || ''}</small></div>
    <div class="day-heading"><span class="eyebrow">{day.stage || '每日行程'}</span><h3>{day.title}</h3><div class="tags">{(day.tags || []).map(tag => <span class="chip">{tag}</span>)}</div></div>
  </header>
  <div class="day-quick">
    <p class="quick-label">当天路线</p><strong>{day.quick?.route || day.title}</strong>
    {day.quick?.fixed?.length > 0 && <div class="fixed">{day.quick.fixed.map(item => <span>{item}</span>)}</div>}
    {day.quick?.note && <p class="quick-note">{day.quick.note}</p>}
  </div>
  <details>
    <summary><span>查看时间、交通、摄影与餐饮</span><b aria-hidden="true">＋</b></summary>
    <div class="day-detail">
      {sections.length > 0 && <nav class="detail-nav" aria-label={`${day.date} 详细目录`}>{sections.map(section => <a href={`#day-${index + 1}-${section.slug}`}>{section.text}</a>)}</nav>}
      <div class="prose day-prose"><Content /></div>
    </div>
  </details>
</article>
<style>
.day-card{overflow:hidden;scroll-margin-top:118px}.day-header{display:flex;gap:20px;padding:22px 24px;background:#f3f0e7;border-bottom:1px solid var(--line)}.day-number{flex:none;width:68px;display:flex;flex-direction:column;color:var(--forest);line-height:1.35}.day-number span{font-size:11px;letter-spacing:.08em;color:var(--accent);font-weight:800}.day-number strong{font-size:23px}.day-number small{font-size:12px;color:var(--muted)}.day-heading{min-width:0}.day-heading h3{font-size:23px;margin:3px 0 10px}.tags{display:flex;gap:5px;flex-wrap:wrap}.day-quick{padding:17px 24px 20px}.quick-label{margin:0;color:var(--accent);font-size:11px;letter-spacing:.12em;font-weight:800}.day-quick>strong{display:block;font-size:17px;line-height:1.5;margin:3px 0 11px}.fixed{display:flex;flex-wrap:wrap;gap:6px}.fixed span{background:#e6eee6;border-radius:8px;padding:5px 8px;font-size:12px;font-weight:700;color:var(--forest)}.quick-note{margin:11px 0 0;color:var(--muted);font-size:14px}details{border-top:1px solid var(--line)}summary{list-style:none;cursor:pointer;background:#edf2e9;color:var(--forest);padding:12px 24px;font-weight:700;display:flex;justify-content:space-between;gap:10px}summary::-webkit-details-marker{display:none}summary b{font-size:20px;line-height:1}details[open] summary b{transform:rotate(45deg)}.day-detail{padding:24px;max-width:100%}.detail-nav{display:flex;flex-wrap:wrap;gap:7px;padding-bottom:20px;border-bottom:1px solid var(--line)}.detail-nav a{border:1px solid var(--line);border-radius:999px;padding:5px 10px;text-decoration:none;color:var(--pine);font-size:12px;font-weight:700}.detail-nav a:hover{background:#e6eee6}.day-prose{max-width:840px}.day-prose :global(h2){font-size:22px;margin:36px 0 16px;padding-bottom:8px;border-bottom:1px solid var(--line);scroll-margin-top:125px}.day-prose :global(h3){font-family:'DM Sans','PingFang SC',sans-serif;font-size:17px;margin:24px 0 8px;color:var(--forest)}.day-prose :global(p),.day-prose :global(li){font-size:14px;line-height:1.85}.day-prose :global(ul){padding-left:22px}.day-prose :global(table){width:100%;font-size:14px}.day-prose :global(th){background:#e9efe8;text-align:left}.day-prose :global(td:first-child){font-weight:700;color:var(--forest);white-space:nowrap}.day-prose :global(a){overflow-wrap:anywhere;font-weight:700}@media(max-width:680px){.day-header{gap:12px;padding:17px}.day-number{width:56px}.day-number strong{font-size:19px}.day-heading h3{font-size:20px}.day-quick,summary{padding-inline:17px}.day-detail{padding:16px 17px 24px}.day-prose :global(h2){font-size:19px}.day-prose :global(table){font-size:13px}}
</style>
