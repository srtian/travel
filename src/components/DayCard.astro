---
import { render } from 'astro:content';
const {entry,index}=Astro.props;
const d=entry.data;
const {Content}=await render(entry);
const hasStructured=Boolean(d.planItems?.length || d.practical?.length || d.slots?.length);
const link=(url)=>url||'';
---
<article class="day-card panel" id={`day-${index+1}`}>
  <header class="day-header"><div><span class="eyebrow">DAY {String(index+1).padStart(2,'0')} · {d.date} {d.weekday||''}</span><h3>{d.title}</h3></div><div class="tags">{(d.tags||[]).map(t=><span class="chip">{t}</span>)}</div></header>
  <div class="day-quick"><span class="quick-label">当天简版</span><strong>{d.quick?.route||d.title}</strong>{d.quick?.fixed?.length>0&&<div class="fixed">{d.quick.fixed.map(item=><span>{item}</span>)}</div>}{d.quick?.note&&<p>{d.quick.note}</p>}</div>
  <details><summary>展开时间安排、地图、摄影和餐饮细节 <span>＋</span></summary><div class="day-detail">
    {hasStructured?<>
      {d.planItems?.length>0&&<section><h4>时间安排</h4><ol class="schedule">{d.planItems.map(p=><li><time>{p.time}</time><span>{p.text}</span></li>)}</ol></section>}
      {d.practical?.length>0&&<section><h4>现场执行细节</h4><div class="detail-grid">{d.practical.map(p=><article class="detail-card"><h5>{p.title}</h5><p>{p.text}</p><div class="links">{p.map&&<a href={p.map} target="_blank" rel="noopener noreferrer">Google 地图 ↗</a>}{p.source&&<a href={p.source} target="_blank" rel="noopener noreferrer">资料依据 ↗</a>}{p.links?.map(l=><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>)}</div></article>)}</div></section>}
      {d.trains?.length>0&&<section><h4>列车与交通班次</h4><div class="detail-grid">{d.trains.map(t=><article class="detail-card"><h5>{t.service}</h5><strong>{t.route}</strong><p>{t.note}</p>{t.source&&<a href={t.source} target="_blank" rel="noopener noreferrer">官方时刻表 ↗</a>}</article>)}</div></section>}
      {d.alternatives?.length>0&&<section><h4>路线方案</h4><div class="detail-grid">{d.alternatives.map(a=><article class="detail-card"><h5>{a.label}</h5><p>{a.summary}</p></article>)}</div></section>}
      {d.sunlight?.length>0&&<section><h4>日出与日落</h4><div class="detail-grid">{d.sunlight.map(s=><article class="detail-card sunlight"><span class="eyebrow">{s.kind} · {s.time}</span><h5>{s.place}</h5><p>{s.advice}</p><div class="links">{s.googleMaps&&<a href={s.googleMaps} target="_blank" rel="noopener noreferrer">Google 地图 ↗</a>}{s.source&&<a href={s.source} target="_blank" rel="noopener noreferrer">地点依据 ↗</a>}{s.timeSource&&<a href={s.timeSource} target="_blank" rel="noopener noreferrer">日出日落时刻 ↗</a>}</div></article>)}</div></section>}
      {d.slots?.length>0&&<section><h4>当天重点</h4><div class="detail-grid">{d.slots.map(s=><article class="detail-card slot">{s.photo&&<img src={s.photo} alt="" loading="lazy" />}<div><span class="eyebrow">{s.time}</span><h5>{s.name}</h5><p>{s.review}</p><div class="facts">{s.openingHours&&<span>{s.openingHours}</span>}{s.ticketPrice&&<span>{s.ticketPrice}</span>}{s.transport&&<span>{s.transport.mode} · {s.transport.duration}</span>}</div></div></article>)}</div></section>}
      {d.photoSpots?.length>0&&<section><h4>沿途摄影机位</h4><div class="detail-grid">{d.photoSpots.map(p=><article class="detail-card"><span class="eyebrow">{p.context} · {p.light}</span><h5>{p.name}</h5><p>{p.advice}</p><div class="links">{p.googleMaps&&<a href={p.googleMaps} target="_blank" rel="noopener noreferrer">Google 地图 ↗</a>}{p.source&&<a href={p.source} target="_blank" rel="noopener noreferrer">地点依据 ↗</a>}</div></article>)}</div></section>}
      {d.dining?.length>0&&<section><h4>沿途吃什么</h4><div class="detail-grid">{d.dining.map(m=><article class="detail-card meal"><span class="eyebrow">{m.meal}</span><h5>{m.place}</h5><p>{m.note}</p><p><b>预约：</b>{m.booking}</p>{m.hours&&<p><b>营业：</b>{m.hours}</p>}{m.dishes?.map(dish=><div class="dish"><span>{dish.name}</span><b>{dish.price}</b></div>)}<div class="links">{m.googleMaps&&<a href={m.googleMaps} target="_blank" rel="noopener noreferrer">Google 地图 ↗</a>}{m.source&&<a href={m.source} target="_blank" rel="noopener noreferrer">营业依据 ↗</a>}</div></article>)}</div></section>}
      {d.tips?.length>0&&<section><h4>当天提醒</h4>{d.tips.map(t=><p class="tip">• {t}</p>)}</section>}
    </>:<div class="prose"><Content /></div>}
  </div></details>
</article>
<style>
.day-card{overflow:hidden;scroll-margin-top:118px}.day-header{display:flex;justify-content:space-between;gap:15px;align-items:end;padding:20px 24px;background:#f3f0e7;border-bottom:1px solid var(--line)}.day-header h3{font-size:24px;margin:7px 0 0}.tags{display:flex;justify-content:end;gap:5px;flex-wrap:wrap}.day-quick{padding:18px 24px}.quick-label{display:block;color:var(--accent);font-size:11px;letter-spacing:.1em;font-weight:800}.day-quick strong{display:block;font-size:18px;margin:4px 0 9px}.day-quick p{margin:8px 0 0;color:var(--muted);font-size:14px}.fixed{display:flex;flex-wrap:wrap;gap:6px}.fixed span{background:#e6eee6;border-radius:8px;padding:4px 7px;font-size:12px;font-weight:700;color:var(--forest)}details{border-top:1px solid var(--line)}summary{list-style:none;cursor:pointer;background:#edf2e9;color:var(--forest);padding:11px 24px;font-weight:700}summary::-webkit-details-marker{display:none}summary span{float:right}.day-detail{padding:16px 24px 28px}.day-detail section{margin-top:20px}.day-detail h4{font-size:19px;margin:0 0 11px}.schedule{padding:0;margin:0;list-style:none}.schedule li{display:grid;grid-template-columns:120px 1fr;gap:12px;padding:9px 0;border-bottom:1px dashed var(--line)}.schedule time{font-weight:700;color:var(--pine)}.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.detail-card{background:#fbfcf9;border:1px solid var(--line);border-radius:13px;padding:15px;overflow:hidden}.detail-card h5{font-size:16px;margin:4px 0 8px}.detail-card p{font-size:14px;color:var(--muted);margin:4px 0 10px}.detail-card a{font-size:12px;color:var(--pine)}.links{display:flex;flex-wrap:wrap;gap:8px}.slot{padding:0}.slot img{width:100%;height:140px;object-fit:cover;display:block}.slot>div{padding:15px}.facts{display:flex;flex-wrap:wrap;gap:5px}.facts span{font-size:11px;background:#e8eee8;padding:4px 7px;border-radius:8px}.sunlight{background:#fff9eb}.meal{background:#fff9f2}.dish{display:flex;justify-content:space-between;gap:8px;border-top:1px dashed var(--line);padding:5px 0;font-size:13px}.tip{font-size:14px;color:var(--muted)}@media(max-width:750px){.day-header{display:block;padding:17px}.day-header h3{font-size:21px}.tags{justify-content:start;margin-top:10px}.day-quick,summary{padding-inline:17px}.day-detail{padding:13px 17px 24px}.detail-grid{grid-template-columns:1fr}.schedule li{grid-template-columns:72px 1fr;gap:8px}}
</style>
