---
const { title, description = '旅行攻略与每日行程', image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#183a32" />
  <meta name="description" content={description} />
  <title>{title}</title>
  {image && <meta property="og:image" content={image} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Serif+SC:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>
  <header class="site-header"><div class="wrap header-inner"><a class="wordmark" href={base}>旅途手帖<span class="wordmark-dot">.</span></a><nav><a href={base}>全部旅行</a><a href={`${base}trips/japan-2026/`}>日本关西</a><a href={`${base}trips/sri-lanka-2026/`}>斯里兰卡</a></nav></div></header>
  <slot />
  <footer class="site-footer"><div class="wrap"><strong>旅途手帖</strong><span>一段路，一本可随时翻开的攻略。</span></div></footer>
</body>
</html>
<style is:global>
:root{--forest:#183a32;--pine:#285747;--ink:#20312a;--muted:#69786e;--paper:#f6f4ed;--card:#fffef9;--line:#d9ded5;--accent:#b64f35;--gold:#d5aa64;--shadow:0 16px 40px #142a2010}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 'DM Sans',-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif}h1,h2,h3,h4{font-family:'Noto Serif SC','Songti SC',serif;line-height:1.25}a{color:inherit;text-underline-offset:3px}button,input{font:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin-inline:auto}.site-header{position:sticky;top:0;z-index:100;background:#f6f4edea;backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.header-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:68px}.wordmark{text-decoration:none;color:var(--forest);font-family:'Noto Serif SC',serif;font-weight:700;font-size:21px;white-space:nowrap}.wordmark-dot{color:var(--accent)}.site-header nav{display:flex;gap:20px;font-size:13px;font-weight:700}.site-header nav a{text-decoration:none;color:var(--muted)}.site-header nav a:hover{color:var(--accent)}.site-footer{margin-top:80px;padding:35px 0;background:var(--forest);color:#fff}.site-footer .wrap{display:flex;justify-content:space-between;gap:20px}.site-footer span{color:#d2ded4}.eyebrow{font-size:12px;letter-spacing:.17em;text-transform:uppercase;font-weight:800;color:var(--accent)}.muted{color:var(--muted)}.chip{display:inline-flex;align-items:center;border-radius:999px;background:#e9efe8;color:var(--forest);padding:5px 10px;font-size:12px;font-weight:700}.panel{background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow)}.prose{line-height:1.85}.prose h1{display:none}.prose h2{margin:35px 0 14px;font-size:24px}.prose h3{margin:26px 0 10px;font-size:19px}.prose p,.prose li{color:#3f5147}.prose a{color:var(--pine)}.prose table{display:block;overflow:auto;border-collapse:collapse;max-width:100%}.prose th,.prose td{padding:8px 11px;border:1px solid var(--line);white-space:nowrap}.prose blockquote{border-left:3px solid var(--gold);padding:1px 16px;margin:22px 0;background:#f8f4e8}.prose img{max-width:100%;height:auto;border-radius:14px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:22px}.section-heading h2{font-size:32px;margin:6px 0 0}.section-heading p{margin:0;color:var(--muted)}
@media(max-width:680px){.wrap{width:min(100% - 28px,520px)}.header-inner{min-height:58px}.site-header nav{gap:10px;font-size:11px}.site-header nav a:first-child{display:none}.site-footer .wrap{display:block}.section-heading{display:block}.section-heading p{margin-top:7px}}
</style>
